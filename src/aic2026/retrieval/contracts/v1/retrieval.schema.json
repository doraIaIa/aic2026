{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic2026.local/contracts/retrieval/v1/retrieval.schema.json",
  "title": "AIC 2026 unified retrieval contract v1",
  "$defs": {
    "lane": {"enum": ["visual", "asr", "ocr", "object"]},
    "SearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request_id", "mode", "query_text", "routing", "filters", "result_limit"],
      "properties": {
        "contract_version": {"const": "retrieval.v1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "mode": {"enum": ["KIS", "QA", "TRAKE"]},
        "query_text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "mode_context": {"type": "object"},
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "enabled_lanes", "object_match"],
          "properties": {
            "strategy": {"enum": ["auto", "manual"]},
            "enabled_lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/lane"}},
            "object_match": {"enum": ["soft", "exact_and"]}
          }
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "video_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "start_sec": {"type": ["number", "null"], "minimum": 0},
            "end_sec": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "result_limit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality", "evidence_id", "rank", "raw_score", "score_kind", "anchor_sec", "artifact_version", "payload"],
      "properties": {
        "modality": {"$ref": "#/$defs/lane"},
        "evidence_id": {"type": "string", "minLength": 1},
        "rank": {"type": "integer", "minimum": 1},
        "raw_score": {"type": ["number", "null"]},
        "score_kind": {"type": "string", "minLength": 1},
        "anchor_sec": {"type": "number", "minimum": 0},
        "artifact_version": {"type": "string", "minLength": 1},
        "payload": {"type": "object"}
      }
    },
    "EvidenceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_window_id", "video_id", "start_sec", "end_sec", "representative", "evidence", "fusion", "sources", "provenance"],
      "properties": {
        "evidence_window_id": {"type": "string", "minLength": 1},
        "video_id": {"type": "string", "minLength": 1},
        "start_sec": {"type": "number", "minimum": 0},
        "end_sec": {"type": "number", "minimum": 0},
        "representative": {
          "type": "object",
          "required": ["kind", "timestamp_sec", "keyframe_id", "frame_idx", "submit_valid", "operator_confirmation_required"],
          "properties": {
            "kind": {"enum": ["visual_keyframe", "dense_frame", "temporal_anchor"]},
            "timestamp_sec": {"type": "number", "minimum": 0},
            "keyframe_id": {"type": ["string", "null"]},
            "frame_idx": {"type": ["integer", "null"], "minimum": 0},
            "submit_valid": {"type": "boolean"},
            "operator_confirmation_required": {"const": true}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Evidence"}},
        "fusion": {"type": "object"},
        "sources": {"type": "object"},
        "provenance": {"type": "object"}
      }
    },
    "SearchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request_id", "status", "route", "providers", "results", "latency_ms", "warnings"],
      "properties": {
        "contract_version": {"const": "retrieval.v1"},
        "request_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["OK", "PARTIAL", "ERROR", "BLOCKED_BY_SCORING_CONTRACT"]},
        "route": {"type": "object"},
        "providers": {"type": "object"},
        "results": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/EvidenceWindow"}},
        "latency_ms": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
